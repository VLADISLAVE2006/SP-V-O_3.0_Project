{
  "info": {
    "name": "Система опросов — проверка интеграции",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Сначала выполните seed_demo. Запускайте запросы по порядку. Токены и id сохраняются автоматически; созданный опрос удаляется в конце. Только для локального стенда."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18083/api"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "slug",
      "value": ""
    },
    {
      "key": "answers",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "Проверка состояния",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo.owner@example.test\",\n  \"password\": \"Demo-Polls-2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "const pair = pm.response.json();",
              "pm.collectionVariables.set(\"access\", pair.access);",
              "pm.collectionVariables.set(\"refresh\", pair.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Создать отдельный тестовый опрос",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/polls",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Проверка интеграции Postman\",\n  \"access_mode\": \"registered\",\n  \"allow_revote\": false,\n  \"questions\": [\n    {\n      \"text\": \"Какой формат удобнее?\",\n      \"type\": \"single\",\n      \"options\": [\n        {\n          \"text\": \"Очно\"\n        },\n        {\n          \"text\": \"Онлайн\"\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "const poll = pm.response.json();",
              "pm.collectionVariables.set(\"slug\", poll.slug);",
              "pm.collectionVariables.set(\"answers\", JSON.stringify(poll.questions.map(q => ({question_id:q.id, option_ids:q.options.slice(0,q.min_choices).map(o=>o.id)}))));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Публикация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/polls/{{slug}}/publish",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход participant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo.participant@example.test\",\n  \"password\": \"Demo-Polls-2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "const pair = pm.response.json();",
              "pm.collectionVariables.set(\"access\", pair.access);",
              "pm.collectionVariables.set(\"refresh\", pair.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Получить вопросы",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/polls/{{slug}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Проголосовать",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/polls/{{slug}}/vote",
        "body": {
          "mode": "raw",
          "raw": "{\"answers\": {{answers}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Результаты участника",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/polls/{{slug}}/results"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Повторный голос должен вернуть 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/polls/{{slug}}/vote",
        "body": {
          "mode": "raw",
          "raw": "{\"answers\": {{answers}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo.owner@example.test\",\n  \"password\": \"Demo-Polls-2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "const pair = pm.response.json();",
              "pm.collectionVariables.set(\"access\", pair.access);",
              "pm.collectionVariables.set(\"refresh\", pair.refresh);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Экспорт CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/polls/{{slug}}/export?format=csv"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Завершение",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/polls/{{slug}}/close",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Удалить созданный этим прогоном опрос",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/polls/{{slug}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "if (pm.response.code === 204) {",
              "pm.collectionVariables.unset(\"slug\");",
              "pm.collectionVariables.unset(\"answers\");",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
